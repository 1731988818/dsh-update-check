{
  "name": "dsh-update-check",
  "version": "1.5.3",
  "private": true,
  "description": "One update check per DeepSeek Harness launch: reports newer app, plugin and CLI versions, and updates profile plugins on click.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1731988818/dsh-update-check.git"
  },
  "bugs": {
    "url": "https://github.com/1731988818/dsh-update-check/issues"
  },
  "homepage": "https://github.com/1731988818/dsh-update-check#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "update",
    "upgrade",
    "version"
  ],
  "license": "MIT",
  "author": "1731988818",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
